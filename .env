# NEXTAUTH_URL=http://localhost:3000

# # Required for NextAuth (generate with: openssl rand -hex 32)
# NEXTAUTH_SECRET=your-secret-key-here-generate-one

# # API URL - where the Keep backend is running
# API_URL=http://localhost:8080

# # Authentication - No Auth mode
# AUTH_TYPE=noauth

# # Logging
# LOG_FORMAT=dev_terminal


# # Required:
# # NEXTAUTH_SECRET= # Linux: `openssl rand -hex 32` or go to https://generate-secret.now.sh/32
# AUTH_TYPE=NOAUTH
# NEXTAUTH_SECRET=f08773dcfbb51517f108e752fb133c33cbf3166fba89d7251ae8e4ed561e2287
# # API
# API_URL=http://localhost:8080
# # # Auth
# # AUTH0_CLIENT_ID=
# # AUTH0_CLIENT_SECRET=
# # AUTH0_ISSUER=
# # Pusher
# PUSHER_HOST=localhost
# PUSHER_PORT=6001
# PUSHER_APP_KEY=keepappkey
# # Logging
# LOG_FORMAT=dev_terminal


NEXTAUTH_URL=http://localhost:3000

# Required for NextAuth
NEXTAUTH_SECRET=your-secret-key-here-generate-one

# API URL - where the Keep backend is running
API_URL=http://localhost:8080

# Authentication - No Auth mode
AUTH_TYPE=noauth

# Logging
LOG_FORMAT=dev_terminal
WORKFLOWS_API_URL=http://localhost:8081

# Hossted widget (@hossted/keep-integration) — HOSSTED_PROXY_URL/HOSSTED_DASHBOARD_URL
# are inlined into the browser bundle (see next.config.js). HOSSTED_UPSTREAM_URL/
# HOSSTED_UPSTREAM_TOKEN/HOSSTED_REDIS_URL are read server-side only, by
# app/api/hossted/route.ts, and never sent to the browser.
HOSSTED_PROXY_URL=http://localhost:3000/api/hossted
HOSSTED_DASHBOARD_URL=https://dashboard.local.hossted.dev:8443
# keep-ui runs as a plain host process (npm run dev), not inside Docker, so
# it reaches these two via their published host ports rather than by Docker
# network/container name.
#
# Points at the hossted-survey-api MOCK server's /api/integrations route
# (not the real local Hossted platform's hkb_rag /api/v1/integrations) —
# see docs/hossted-mock-setup.md. HOSSTED_UPSTREAM_TOKEN must match the
# "keep" integration's tokenValue on that mock server (the setup doc's
# curl step sets both to this same value).
HOSSTED_UPSTREAM_URL=http://localhost:4400/api/integrations
HOSSTED_UPSTREAM_TOKEN=mock-keep-token
HOSSTED_REDIS_URL=redis://localhost:6381
